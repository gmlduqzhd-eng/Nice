# Optional: server-only NEIS public data key. Never prefix this variable NEXT_PUBLIC_.
NEIS_API_KEY=

# Optional: cloud account and manual workspace snapshots.
# Get both from the chosen Supabase project's Connect / API Keys settings.
NEXT_PUBLIC_SUPABASE_URL=
# Modern public key beginning with sb_publishable_. Never use service_role / sb_secret_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Google login button. Keep false until the Supabase Google provider
# and OAuth redirect URLs are configured and verified. Rebuild after changing.
# OAuth client secrets belong only in Supabase provider settings, never here.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
