# Optional: server-only NEIS public data key. Never prefix this variable NEXT_PUBLIC_.
NEIS_API_KEY=

# Optional: cloud account and manual workspace snapshots.
# Get both from the chosen Supabase project's Connect / API Keys settings.
NEXT_PUBLIC_SUPABASE_URL=
# Modern public key beginning with sb_publishable_. Never use service_role / sb_secret_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Google Identity Services (GIS) login using signInWithIdToken.
# Public Web Client ID; use the same ID in the Supabase Google provider.
# This identifier is public. Do not put a Client Secret or user tokens here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Keep false until the provider and this environment's exact Google JavaScript
# origin are configured. Enable for the target build, then verify real sign-in.
# GIS does not use a Client Secret. Rebuild after changing either public value.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
