{
  "name": "damim-assistant",
  "version": "0.4.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/package-neis-helper.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/package-neis-helper.mjs && next build",
    "package:extension": "node scripts/package-neis-helper.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.38.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  }
}
